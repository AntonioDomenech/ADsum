<Window x:Class="ADsum.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADsum" Height="860" Width="1180" MinHeight="720" MinWidth="980"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="ADsum v3.2" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Meeting Recorder" FontSize="34" FontWeight="Bold" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="18,8" VerticalAlignment="Center">
                <TextBlock x:Name="StateText" Text="Idle" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            </Border>
        </DockPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Record">
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Meeting topic (optional)" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                    <TextBox x:Name="SessionNameBox" Margin="0,7,0,18" MinHeight="38" Padding="8"
                             ToolTip="Leave this blank and ADsum will name the meeting from its transcript." />

                    <TextBlock Text="Transcription model" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                    <ComboBox x:Name="RecordModelCombo" Margin="0,7,0,5" MinHeight="38"
                              SelectionChanged="TranscriptionModelCombo_SelectionChanged" />
                    <TextBlock x:Name="RecordModelDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               FontSize="12" MinHeight="42" Margin="0,0,0,14" />

                    <TextBlock Text="Microphone" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                    <ComboBox x:Name="MicrophoneCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,7,0,4" MinHeight="38" />
                    <TextBlock x:Name="MicrophoneWarningText" Foreground="#9A6700" TextWrapping="Wrap" FontSize="12" MinHeight="34" />

                    <TextBlock Text="System audio" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                    <ComboBox x:Name="OutputCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,7,0,4" MinHeight="38" />
                    <TextBlock x:Name="OutputWarningText" Foreground="#9A6700" TextWrapping="Wrap" FontSize="12" MinHeight="34" />

                    <Grid Margin="0,12,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="RefreshButton" Grid.Column="0" Grid.Row="0" Content="Refresh" Click="RefreshButton_Click" />
                        <Button x:Name="TestButton" Grid.Column="2" Grid.Row="0" Content="Test 6 s" Click="TestButton_Click" />
                        <Button x:Name="RecordButton" Grid.Column="0" Grid.Row="2" Content="Record" Style="{StaticResource PrimaryButton}" Click="RecordButton_Click" />
                        <Button x:Name="StopButton" Grid.Column="2" Grid.Row="2" Content="Stop" Style="{StaticResource DangerButton}" Click="StopButton_Click" IsEnabled="False" />
                    </Grid>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="OpenAI key" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                            <Grid Margin="0,7,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyBox" MinHeight="38" Padding="8" />
                                <Button Grid.Column="2" x:Name="SaveKeyButton" Content="Save" Click="SaveKeyButton_Click" />
                            </Grid>
                            <TextBlock x:Name="KeyStateText" Text="Checking key..." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="170" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="220" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,18">
                            <TextBlock Text="Levels" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" />
                            <TextBlock x:Name="ElapsedText" Text="00:00" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Mic" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ProgressBar x:Name="MicLevelBar" Grid.Column="1" Grid.Row="0" Height="14" Maximum="1" />
                            <TextBlock Grid.Row="1" Text="System" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ProgressBar x:Name="SystemLevelBar" Grid.Column="1" Grid.Row="1" Height="14" Maximum="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="Last Recording" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="OpenFolderButton" Content="Open folder" MinWidth="112" Margin="0,0,8,0" Click="OpenFolderButton_Click" IsEnabled="False" />
                                <Button x:Name="OpenRecordingButton" Content="Open recording" MinWidth="126" Margin="0,0,8,0" Click="OpenRecordingButton_Click" IsEnabled="False" />
                                <Button x:Name="TranscribeButton" Content="Transcribe with selected model" MinWidth="210" Margin="0,0,8,0" Click="TranscribeButton_Click" IsEnabled="False" />
                                <Button x:Name="CreateNotesButton" Content="Create notes" MinWidth="118" Click="CreateNotesButton_Click" IsEnabled="False" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="ResultText" Text="No recording yet." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Review" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="OpenMinutesButton" Content="Open minutes" MinWidth="112" Margin="0,0,8,0" Click="OpenMinutesButton_Click" IsEnabled="False" />
                                <Button x:Name="OpenTranscriptButton" Content="Open transcript" MinWidth="126" Margin="0,0,12,0" Click="OpenTranscriptButton_Click" IsEnabled="False" />
                                <TextBlock x:Name="TranscriptStateText" Text="Ready" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TabControl Grid.Row="1">
                            <TabItem Header="Minutes">
                                <TextBox x:Name="MinutesBox" Text="Create a transcript, then create notes." TextWrapping="Wrap"
                                         AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
                                         Background="Transparent" FontSize="14" Padding="8" />
                            </TabItem>
                            <TabItem Header="Transcript">
                                <TextBox x:Name="TranscriptBox" Text="Record audio, then create a transcript." TextWrapping="Wrap"
                                         AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
                                         Background="Transparent" FontSize="14" Padding="8" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
            </TabItem>
            <TabItem Header="Library">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Previous Meetings" FontSize="18" FontWeight="Bold" />
                                    <TextBlock x:Name="LibraryCountText" Text="No meetings loaded" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="LibraryRefreshButton" Content="Refresh" DockPanel.Dock="Right" MinWidth="96" Click="LibraryRefreshButton_Click" />
                            </DockPanel>
                            <ListBox x:Name="LibraryList" Grid.Row="2" SelectionChanged="LibraryList_SelectionChanged"
                                     BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding FileSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LibraryTitleText" Text="Select a meeting" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="LibraryDetailsText" Grid.Row="1" Text="Saved recordings and notes will appear here." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

                            <DockPanel Grid.Row="3">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Transcription model" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ComboBox x:Name="LibraryModelCombo" Grid.Column="1" MinHeight="38"
                                                  SelectionChanged="TranscriptionModelCombo_SelectionChanged" />
                                    </Grid>
                                    <TextBlock x:Name="LibraryModelDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               FontSize="12" Margin="150,0,0,10" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Saved transcript" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ComboBox x:Name="LibraryTranscriptVersionCombo" Grid.Column="1" MinHeight="38"
                                                  SelectionChanged="LibraryTranscriptVersionCombo_SelectionChanged" />
                                    </Grid>
                                    <WrapPanel>
                                    <Button x:Name="LibraryOpenFolderButton" Content="Open folder" MinWidth="112" Margin="0,0,8,0" Click="LibraryOpenFolderButton_Click" IsEnabled="False" />
                                    <Button x:Name="LibraryOpenRecordingButton" Content="Open recording" MinWidth="126" Margin="0,0,8,0" Click="LibraryOpenRecordingButton_Click" IsEnabled="False" />
                                    <Button x:Name="LibraryTranscribeButton" Content="Transcribe with selected model" MinWidth="196" Margin="0,0,8,0" Click="LibraryTranscribeButton_Click" IsEnabled="False" />
                                    <Button x:Name="LibraryCreateNotesButton" Content="Create notes" MinWidth="118" Margin="0,0,8,0" Click="LibraryCreateNotesButton_Click" IsEnabled="False" />
                                    <Button x:Name="LibraryOpenMinutesButton" Content="Open minutes" MinWidth="112" Margin="0,0,8,0" Click="LibraryOpenMinutesButton_Click" IsEnabled="False" />
                                    <Button x:Name="LibraryOpenTranscriptButton" Content="Open transcript" MinWidth="126" Click="LibraryOpenTranscriptButton_Click" IsEnabled="False" />
                                    </WrapPanel>
                                </StackPanel>
                                <TabControl>
                                    <TabItem Header="Minutes">
                                        <TextBox x:Name="LibraryMinutesBox" Text="Select a meeting with minutes." TextWrapping="Wrap"
                                                 AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                                 BorderThickness="0" Background="Transparent" FontSize="14" Padding="8" />
                                    </TabItem>
                                    <TabItem Header="Transcript">
                                        <TextBox x:Name="LibraryTranscriptBox" Text="Select a meeting with a transcript." TextWrapping="Wrap"
                                                 AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                                 BorderThickness="0" Background="Transparent" FontSize="14" Padding="8" />
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="General">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="390" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="General transcription settings" FontSize="22" FontWeight="Bold" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,16">
                                <TextBlock Text="Default transcription model" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                                <ComboBox x:Name="GeneralModelCombo" Margin="0,7,0,5" MinHeight="38"
                                          SelectionChanged="TranscriptionModelCombo_SelectionChanged" />
                                <TextBlock x:Name="GeneralModelDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock Text="Relevant terms" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Enter one name, company, acronym, product, or specialist term per line. These terms are saved globally and reused for every compatible transcription."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBox x:Name="GeneralTermsBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10" FontSize="14" />
                            <DockPanel Grid.Row="4" Margin="0,14,0,0">
                                <Button x:Name="SaveGeneralButton" Content="Save general settings" Style="{StaticResource PrimaryButton}"
                                        MinWidth="170" Click="SaveGeneralButton_Click" DockPanel.Dock="Left" />
                                <TextBlock x:Name="GeneralSettingsStateText" Text="Settings loaded" Foreground="{StaticResource MutedBrush}"
                                           Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Compressed audio" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="ADsum preserves every original WAV and creates recording-compressed.mp3 beside it. All transcription models receive that MP3, including the local model."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,16" />
                            <Button x:Name="CompressLibraryButton" Content="Check and compress older recordings" Click="CompressLibraryButton_Click" />
                            <TextBlock x:Name="CompressionStateText" Text="Older-recording check will start automatically."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,22" />

                            <TextBlock Text="Model behavior" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Local Whisper + Pyannote and GPT-4o Transcribe Diarize include anonymous speaker labels. GPT Transcribe produces the new high-accuracy text transcript but does not include speaker diarization. OpenAI's specialized diarization endpoint does not accept vocabulary hints; your global terms remain saved for the other compatible models."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
